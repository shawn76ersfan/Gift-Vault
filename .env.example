# Copy to .env.local and fill in. Never commit real keys.

# Written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=

# Clerk dashboard -> API keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Stripe dashboard -> Developers -> API keys (publishable key only on the client)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Server-side secrets live in Convex, not here. Set them with:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_xxx
#   npx convex env set STRIPE_SECRET_KEY sk_test_xxx
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_xxx
#   npx convex env set TREMENDOUS_API_KEY TEST_xxx
#   npx convex env set TREMENDOUS_FUNDING_SOURCE_ID xxx
#   npx convex env set TREMENDOUS_CAMPAIGN_ID xxx   (optional)
